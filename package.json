{
  "name": "guanlan-paper",
  "version": "1.9.7",
  "description": "观澜 A 股模拟交易桌面工具",
  "author": "Guanlan",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.guanlan.paper",
    "productName": "Guanlan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "core/**",
      "ui/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/{bmp-js,idb-keyval,is-url,node-fetch,whatwg-url,tr46,webidl-conversions,opencollective-postinstall,regenerator-runtime,wasm-feature-detect,zlibjs}/**",
      "assets/ocr/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Guanlan-${version}-win-x64.exe"
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  }
}
